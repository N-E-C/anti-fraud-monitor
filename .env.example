# 数据库配置
DATABASE_URL=sqlite:///data/monitor.db

# 微博Cookie（必须，不然抓不到数据）
WEIBO_COOKIE=

# 知乎Cookie（必须）
ZHIHU_COOKIE=

# 抖音配置（如果用第三方数据平台）
# DOUYIN_API_KEY=

# 小红书Cookie（如果自己爬）
# XIAOHONGSHU_COOKIE=

# 快手Cookie
# KUAISHOU_COOKIE=

# 爬取间隔（分钟）
CRAWL_INTERVAL_MINUTES=60

# 每日报表生成时间（小时，24小时制）
REPORT_HOUR=8

# 日志级别
LOG_LEVEL=INFO

# 代理配置（可选）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ========== 邮件预警配置 ==========
# SMTP服务器（按自己使用的邮箱服务商填写）
SMTP_SERVER=smtp.139.com
SMTP_PORT=465
# 发件邮箱：填写自己的告警邮箱，勿使用真实号码邮箱提交到公开仓库
SMTP_SENDER=your_alert_mailbox@example.com
SMTP_PASSWORD=你的授权码

# 预警接收邮箱
ALERT_RECEIVER=your_alert_mailbox@example.com
