# 数据库配置
DATABASE_URL=sqlite:///data/monitor.db

# 微博Cookie（必须，不然抓不到数据）
WEIBO_COOKIE=

# 知乎Cookie（必须）
ZHIHU_COOKIE=

# 抖音配置（如果用第三方数据平台）
# DOUYIN_API_KEY=

# 小红书Cookie（如果自己爬）
# XIAOHONGSHU_COOKIE=

# 快手Cookie
# KUAISHOU_COOKIE=

# 爬取间隔（分钟）
CRAWL_INTERVAL_MINUTES=60

# 每日报表生成时间（小时，24小时制）
REPORT_HOUR=8

# 日志级别
LOG_LEVEL=INFO

# 代理配置（可选）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
